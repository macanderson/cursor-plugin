#!/usr/bin/env bash
# SessionStart hook for the Oxagen Cursor plugin.
#
# Force-loads the using-oxagen gate skill into the session as
# `additional_context`, wrapped in <EXTREMELY_IMPORTANT> tags so the agent
# applies the routing policy on every turn before tool selection.
#
# Pins three guarantees:
#   1. Graph first — the Oxagen workspace is the source of truth.
#   2. Memory always recalled before any non-trivial action.
#   3. Coordinate with parallel agents via the agent.* surface.
#
# Cursor passes per-hook JSON over stdin; we ignore it and emit context.
# Pattern derived from the superpowers plugin (MIT, Jesse Vincent).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
RULES_DIR="${PLUGIN_ROOT}/.cursor/rules"

gate_content=$(cat "${RULES_DIR}/using-oxagen.mdc" 2>&1 \
    || echo "Error reading using-oxagen rule")

# Escape a string for embedding inside a JSON string value.
# Bash parameter substitution is orders of magnitude faster than a
# character-by-character loop and avoids spawning jq for one field.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\b'/\\b}"
    s="${s//$'\f'/\\f}"
    printf '%s' "$s"
}

preamble=$(cat <<'PREAMBLE'
The Oxagen plugin is installed and enabled for this Cursor session. The
workspace this session is acting on is exposed as a typed, queryable
knowledge graph over MCP, with durable agent memory layered on top.

Treat Oxagen as a first-class concern on every turn — not only for code:

1. **Graph first, guess second.** Before any non-trivial action — code edit,
   research synthesis, incident triage, ops change, customer-impact analysis,
   policy lookup — query the Oxagen graph (`ontology.*`, `code.*`,
   `incident.*`, `security.*`, `workspace.*`). The graph is deterministic;
   name-matches and prior context are not.

2. **Memory always recalled.** At the start of any task, call
   `memory.recall` (or the routing rule's equivalent) on the intent. If a
   procedure or episode matches, prefer it over rediscovery — that is the
   value of memory. After meaningful work, persist what you learned with
   `memory.remember` and `agent.record_finding` so the next session inherits
   it.

3. **Coordinate.** Other agents may be operating against the same workspace.
   Use `agent.list_active_claims` before editing shared scope and
   `agent.claim_work` while you hold it.

The full routing policy lives in the `using-oxagen` rule below. The
exhaustive tool catalog lives in the `oxagen-tool-reference` rule — load it
on demand. Write-back conventions live in the `oxagen-dogfooding` rule —
load it after meaningful changes.
PREAMBLE
)

preamble_escaped=$(escape_for_json "$preamble")
gate_escaped=$(escape_for_json "$gate_content")
session_context="<EXTREMELY_IMPORTANT>\n${preamble_escaped}\n\n--- BEGIN using-oxagen RULE ---\n\n${gate_escaped}\n\n--- END using-oxagen RULE ---\n</EXTREMELY_IMPORTANT>"

# Cursor's sessionStart hook reads top-level `additional_context` from the
# JSON output. printf is used instead of a heredoc to avoid bash 5.3+
# heredoc hangs in some shells.
printf '{\n  "additional_context": "%s"\n}\n' "$session_context"

exit 0
